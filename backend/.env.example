# Copy this file to .env and fill in real values. See app/config.py (Settings)
# for the authoritative field list — keep this file in sync with it.

# LLM providers — Groq is tried first, Gemini is the fallback (see app/services/llm.py)
GROQ_API_KEY=
GEMINI_API_KEY=

# Qdrant vector database (Qdrant Cloud or self-hosted)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sonar_rag_chunks

# Comma-separated list of origins allowed to call this API (see CORSMiddleware in app/main.py)
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000
